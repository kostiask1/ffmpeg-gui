{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Forge",
  "version": "0.1.0",
  "identifier": "com.audioforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Forge",
        "width": 1180,
        "height": 800,
        "minWidth": 880,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["third-party/ffmpeg/*"],
    "shortDescription": "Mix and concatenate large audio files locally",
    "category": "Music"
  }
}
